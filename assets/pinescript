        label_strike2 := label.new(x = expiry_time, y = strike2, text = leg2_lbl + ": " + str.tostring(strike2), xloc = xloc.bar_time, color = color_strike_line, textcolor = color.white, style = label.style_label_left, size = size.small)
        
        be1 := strike2 - premium
        line_be1 := line.new(x1 = open_time, y1 = be1, x2 = expiry_time, y2 = be1, xloc = xloc.bar_time, color = color_be_line, style = line.style_dotted, width = 2)
        label_be1 := label.new(x = open_time, y = be1, text = "Breakeven: " + str.tostring(be1), xloc = xloc.bar_time, color = color_be_line, textcolor = color.black, style = label.style_label_right, size = size.small)

        pbox_bot1 := low_limit
