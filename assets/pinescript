        line_strike1 := line.new(x1 = open_time, y1 = strike1, x2 = expiry_time, y2 = strike1, xloc = xloc.bar_time, color = color_strike_line, style = line.style_solid, width = 2)
        label_strike1 := label.new(x = expiry_time, y = strike1, text = leg1_lbl + ": " + str.tostring(strike1), xloc = xloc.bar_time, color = color_strike_line, textcolor = color.white, style = label.style_label_left, size = size.small)
        
