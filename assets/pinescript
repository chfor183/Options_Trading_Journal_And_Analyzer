    line.delete(line_expiry)
    line.delete(line_strike1)
    line.delete(line_strike2)
    line.delete(line_strike3)
    line.delete(line_strike4)
    line.delete(line_be1)
    line.delete(line_be2)
    line.delete(line_em_up)
    line.delete(line_em_down)
    
    box.delete(profit_box1)
    box.delete(profit_box2)
    
    label.delete(label_open)
    label.delete(label_expiry)
    label.delete(label_strike1)
    label.delete(label_strike2)
    label.delete(label_strike3)
    label.delete(label_strike4)
    label.delete(label_be1)
    label.delete(label_be2)
    label.delete(label_em_up)
    label.delete(label_em_down)

    // 2. Classify strategy name (lowercase for easy matching)
    strategy = strategy_raw == "" ? "Short Iron Condor" : strategy_raw
    clean_strat = str.lower(strategy)
    
    is_credit = str.pos(clean_strat, "credit") >= 0 or clean_strat == "covered call" or clean_strat == "cash-secured put" or clean_strat == "bear call spread" or clean_strat == "bull put spread" or clean_strat == "short iron condor"
    
    // Determine bounds for drawing vertical lines and default boundaries
    float max_strike = underlying_open
    float min_strike = underlying_open
    
    if not na(strike1)
        max_strike := math.max(max_strike, strike1)
        min_strike := math.min(min_strike, strike1)
    if not na(strike2)
        max_strike := math.max(max_strike, strike2)
        min_strike := math.min(min_strike, strike2)
    if not na(strike3)
        max_strike := math.max(max_strike, strike3)
        min_strike := math.min(min_strike, strike3)
    if not na(strike4)
        max_strike := math.max(max_strike, strike4)
        min_strike := math.min(min_strike, strike4)
        
    float spread_range = max_strike - min_strike
    if spread_range == 0
        spread_range := underlying_open * 0.10 // 10% default height
        
    float high_limit = max_strike + spread_range * 0.5 + premium
    float low_limit = math.max(0, min_strike - spread_range * 0.5 - premium)

