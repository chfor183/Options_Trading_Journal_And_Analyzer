    color_green_fill = color.new(color.green, 85)
    color_green_border = color.new(color.green, 50)
    color_strike_line = color.blue
    color_date_line = color.orange
    color_be_line = color.yellow
    
    // 3. Draw Vertical Lines for Date Opened and Expiry Date
    line_open := line.new(x1 = open_time, y1 = low_limit, x2 = open_time, y2 = high_limit, xloc = xloc.bar_time, color = color_date_line, style = line.style_dashed, width = 1)
    line_expiry := line.new(x1 = expiry_time, y1 = low_limit, x2 = expiry_time, y2 = high_limit, xloc = xloc.bar_time, color = color_date_line, style = line.style_dashed, width = 1)
    
    // Date Labels placed at the underlying_open price level
    label_open := label.new(x = open_time, y = high_limit, text = "Opened\n" + open_date_str, xloc = xloc.bar_time, color = color_date_line, textcolor = color.white, style = label.style_label_down, size = size.small)
    label_expiry := label.new(x = expiry_time, y = high_limit, text = "Expiry\n" + expiry_date_str, xloc = xloc.bar_time, color = color_date_line, textcolor = color.white, style = label.style_label_down, size = size.small)

    // --- Draw Expected Move (EM) Bounds if available ---
