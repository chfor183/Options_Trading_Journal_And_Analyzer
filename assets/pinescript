        profit_box1 := box.new(left = open_time, top = pbox_top1, right = expiry_time, bottom = pbox_bot1, bgcolor = color_green_fill, border_color = color_green_border, border_style = line.style_dotted, xloc = xloc.bar_time)

    else if clean_strat == "bear call spread" or str.pos(clean_strat, "bear call spread") >= 0
        leg1_lbl := "Short Call (Sell) Strike"
        leg2_lbl := "Long Call (Buy) Strike"
        
        line_strike1 := line.new(x1 = open_time, y1 = strike1, x2 = expiry_time, y2 = strike1, xloc = xloc.bar_time, color = color_strike_line, style = line.style_solid, width = 2)
        label_strike1 := label.new(x = expiry_time, y = strike1, text = leg1_lbl + ": " + str.tostring(strike1), xloc = xloc.bar_time, color = color_strike_line, textcolor = color.white, style = label.style_label_left, size = size.small)
        
        line_strike2 := line.new(x1 = open_time, y1 = strike2, x2 = expiry_time, y2 = strike2, xloc = xloc.bar_time, color = color_strike_line, style = line.style_solid, width = 2)
        label_strike2 := label.new(x = expiry_time, y = strike2, text = leg2_lbl + ": " + str.tostring(strike2), xloc = xloc.bar_time, color = color_strike_line, textcolor = color.white, style = label.style_label_left, size = size.small)
        
        be1 := strike1 + premium
        line_be1 := line.new(x1 = open_time, y1 = be1, x2 = expiry_time, y2 = be1, xloc = xloc.bar_time, color = color_be_line, style = line.style_dotted, width = 2)
        label_be1 := label.new(x = open_time, y = be1, text = "Breakeven: " + str.tostring(be1), xloc = xloc.bar_time, color = color_be_line, textcolor = color.black, style = label.style_label_right, size = size.small)

