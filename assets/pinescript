        pbox_top1 := high_limit
        profit_box1 := box.new(left = open_time, top = pbox_top1, right = expiry_time, bottom = pbox_bot1, bgcolor = color_green_fill, border_color = color_green_border, border_style = line.style_dotted, xloc = xloc.bar_time)

    else if clean_strat == "long put" or str.pos(clean_strat, "long put") >= 0
