var line line_expiry = na
var line line_strike1 = na
var line line_strike2 = na
var line line_strike3 = na
var line line_strike4 = na
var line line_be1 = na
var line line_be2 = na
var line line_em_up = na
var line line_em_down = na

var box profit_box1 = na
var box profit_box2 = na

var label label_open = na
var label label_expiry = na
var label label_strike1 = na
var label label_strike2 = na
var label label_strike3 = na
var label label_strike4 = na
var label label_be1 = na
var label label_be2 = na
var label label_em_up = na
var label label_em_down = na

// Fixed Table initialized once and re-used
var table info_table = table.new(position = position.top_right, columns = 2, rows = 6, bgcolor = color.new(color.black, 30), border_width = 1, border_color = color.gray)

// --- Logic to Draw on Chart ---
if barstate.islast and not na(open_time) and not na(expiry_time) and not na(underlying_open) and not na(premium)
