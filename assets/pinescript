  '  "strike4": 435.0\n' +
  '}'

// --- Inputs ---
json_input = input.text_area(title="Option Strategy JSON", defval=default_json)

// --- Helper JSON Extraction Functions ---
get_string_value(string json, string key) =>
    string search_key = "\"" + key + "\""
    int pos = str.pos(json, search_key)
    string val = ""
    if not na(pos)
        // Find the colon after key
        int colon_pos = str.pos(str.substring(json, pos + str.length(search_key)), ":")
        if not na(colon_pos)
            int start_from = pos + str.length(search_key) + colon_pos + 1
            if start_from < str.length(json)
                // Now find the opening quote of the string value
                string remaining = str.substring(json, start_from)
                int quote1 = str.pos(remaining, "\"")
                if not na(quote1) and quote1 + 1 < str.length(remaining)
                    string value_rem = str.substring(remaining, quote1 + 1)
                    int quote2 = str.pos(value_rem, "\"")
                    if not na(quote2)
                        val := str.substring(value_rem, 0, quote2)
    val

get_number_value(string json, string key) =>
    string search_key = "\"" + key + "\""
    int pos = str.pos(json, search_key)
    float val = na
    if not na(pos)
        int colon_pos = str.pos(str.substring(json, pos + str.length(search_key)), ":")
        if not na(colon_pos)
            int start_from = pos + str.length(search_key) + colon_pos + 1
            if start_from < str.length(json)
                string remaining = str.substring(json, start_from)
                string num_str = ""
                bool found_digit_or_sign = false
                for i = 0 to str.length(remaining) - 1
                    string char = str.substring(remaining, i, i + 1)
                    bool is_digit = (char == "0" or char == "1" or char == "2" or char == "3" or char == "4" or char == "5" or char == "6" or char == "7" or char == "8" or char == "9" or char == "." or char == "-")
                    if is_digit
                        num_str := num_str + char
                        found_digit_or_sign := true
                    else
                        if found_digit_or_sign
                            break
                if num_str != ""
                    val := str.tonumber(num_str)
    val

// --- Parse JSON Fields ---
strategy_raw = get_string_value(json_input, "strategy")
underlying_open = get_number_value(json_input, "underlying_open")
raw_premium = get_number_value(json_input, "premium")
open_date_str = get_string_value(json_input, "open_date")
expiry_date_str = get_string_value(json_input, "expiry_date")
pop = get_number_value(json_input, "pop")
expected_move = get_number_value(json_input, "expected_move") // Expected Move (e.g. 15.5 or percentage like 5.0)

strike1 = get_number_value(json_input, "strike1")
strike2 = get_number_value(json_input, "strike2")
strike3 = get_number_value(json_input, "strike3")
strike4 = get_number_value(json_input, "strike4")

// Auto-scale premium if entered as total contract premium instead of per-share premium
float premium = raw_premium
if not na(underlying_open) and underlying_open > 0
    if not na(raw_premium) and raw_premium > underlying_open
        premium := raw_premium / 100.0
    else if not na(raw_premium) and not na(strike1) and not na(strike2)
        float width = math.abs(strike2 - strike1)
        if width > 0 and raw_premium > width
            premium := raw_premium / 100.0

// --- Parse Dates (No Time Required) ---
parse_date_time(string dt_str) =>
    if str.length(dt_str) < 10
        na
    else
        int y = int(str.tonumber(str.substring(dt_str, 0, 4)))
        int m = int(str.tonumber(str.substring(dt_str, 5, 7)))
        int d = int(str.tonumber(str.substring(dt_str, 8, 10)))
        timestamp(syminfo.timezone, y, m, d, 0, 0, 0)

open_time = parse_date_time(open_date_str)
expiry_time = parse_date_time(expiry_date_str)

// --- Drawing Object Storage (using var to keep track and replace) ---
